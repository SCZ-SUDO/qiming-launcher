{
  "name": "qiming-launcher",
  "productName": "Qiming",
  "version": "1.0.0",
  "description": "Qiming Launcher - a cross-platform Minecraft launcher",
  "main": "main.js",
  "author": "wb",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node tools/selftest.js",
    "icon": "node tools/makeicon.js",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:win": "electron-builder --win portable",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.wb.qiming",
    "productName": "Qiming",
    "artifactName": "Qiming-${version}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.games",
      "icon": "build/icon.png",
      "darkModeSupport": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Qiming ${version}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Game"
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  }
}
